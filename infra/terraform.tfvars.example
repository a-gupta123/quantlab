# Copy to terraform.tfvars (gitignored) and fill in. No secrets go here:
# app secrets are generated by Terraform and the DB password is managed by RDS.

aws_region      = "us-east-1"
environment     = "demo"
domain_name     = "quantlab.example.com"
certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Optional: create the DNS record automatically.
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Must match how build-push.sh builds images (Apple-silicon Macs build ARM64 natively).
# cpu_architecture = "ARM64"

# Trial teardown settings (default true / 7 protect real data):
# deletion_protection         = false
# secret_recovery_window_days = 0
