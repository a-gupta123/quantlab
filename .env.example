# Copy to .env and replace every value. Never commit .env.
# Generate random secrets with:  openssl rand -base64 32

# PostgreSQL password for the local Compose database.
POSTGRES_PASSWORD=change-me-postgres

# Shared secret the Next.js server sends to the API. The browser never sees it.
API_INTERNAL_TOKEN=change-me-api-token

# Signs the session cookie. At least 32 characters.
SESSION_SECRET=change-me-session-secret-at-least-32-characters

# The single login password for the dashboard.
APP_PASSWORD=change-me-password

# false only for plain-http localhost. Leave true (default) behind HTTPS.
COOKIE_SECURE=false

# Optional: host port for the frontend.
# FRONTEND_PORT=3000

# OpenAI key for the strategy builder chatbot (required for that page; costs money
# per message). Leave empty to run everything else without an LLM.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional LLM explanation of workflow summaries (off by default; uses the same key).
# LLM_EXPLANATIONS_ENABLED=false
